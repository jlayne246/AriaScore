{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "APP_VERSION": "1.0.4",
        "USE_DEV_CLIENT": "false"
      }
    },

    "production-apk": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "APP_VERSION": "1.0.4",
        "USE_DEV_CLIENT": "false"
      }
    },

    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "preview",
        "APP_VERSION": "1.1.0",
        "USE_DEV_CLIENT": "false"
      }
    },

    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "APP_VERSION": "1.1.0",
        "USE_DEV_CLIENT": "true"
      }
    }
  }
}