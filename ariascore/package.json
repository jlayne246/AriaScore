{
  "name": "ariascore",
  "version": "1.0.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "cross-env APP_VARIANT=development expo prebuild --platform ios",
    "ios:preview": "cross-env APP_VARIANT=preview expo prebuild --platform ios",
    "ios:prod": "cross-env APP_VARIANT=production expo prebuild --platform ios",
    "ios:dev:clean": "cross-env APP_VARIANT=development expo prebuild --clean --platform ios",
    "ios:preview:clean": "cross-env APP_VARIANT=preview expo prebuild --clean --platform ios && npm run ios:fix-target",
    "ios:fix-target": "sed -i 's/IPHONEOS_DEPLOYMENT_TARGET = 15.1;/IPHONEOS_DEPLOYMENT_TARGET = 15.5;/g' ios/*.xcodeproj/project.pbxproj",
    "ios:prod:clean": "cross-env APP_VARIANT=production expo prebuild --clean --platform ios",
    "ios:check": "expo-modules-autolinking resolve --platform apple",
    "ios:build:preview": "npx eas-cli build --profile preview --platform ios",
    "ios:build:simulator": "npx eas-cli build --profile ios-simulator --platform ios",
    "ios:build:production": "npx eas-cli build --profile production --platform ios",
    "ios:preview:full": "npm run ios:preview:clean && npm run ios:check && npm run ios:build:preview",
    "web": "expo start --web",
    "generate:licenses": "license-checker --json --production --out ./src/generated/licenses.json",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.9",
    "@react-navigation/native-stack": "^7.3.13",
    "@shopify/react-native-skia": "2.2.12",
    "@types/jest": "29.5.14",
    "ariascore-pdf-import": "file:./modules/ariascore-pdf-import",
    "ariascore-pdf-renderer": "file:./modules/ariascore-pdf-renderer",
    "babel": "^6.23.0",
    "babel-preset-expo": "~54.0.10",
    "dotenv": "^17.2.1",
    "expo": "^54.0.0",
    "expo-application": "~7.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-screen-orientation": "~9.0.9",
    "expo-share-intent": "^5.0.0",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "nativewind": "^4.2.7",
    "postcss": "^8.4.27",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-blob-util": "^0.22.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-pager-view": "6.9.1",
    "react-native-pdf-renderer": "^2.3.0",
    "react-native-popup-menu": "^0.18.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-face-detector": "^2.1.0",
    "react-native-worklets": "0.5.1",
    "react-native-zip-archive": "^9.0.2",
    "solar-icon-set": "^2.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-runtime": "^7.27.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "cross-env": "^10.1.0",
    "license-checker": "^25.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "private": true
}
